  "def_core_battery_desc": "The storage capacity of the built-in accumulators can be further expanded with additional energy storage cells. This module raises total accumulator capacity by {%core_max%}.\n  ",
  "def_core_booster_desc": "Injectors are mobile, instant energy sources to replenish energy into the accumulator. The module uses a specific energy injector charge at each refill.\n  ",
  "ext_targeting_desc": "Each level of this extension raises your [[Help:Robot_parameters|maximum number of locked targets]] by {%BONUS%}, up to your robots' maximum.\n  ",
  "ext_electronics_desc": "Each level of this extension raises the [[Help:Robot_parameters|CPU performance]] of your robots by an additional {%BONUS100%}%.\n  ",
  "ext_electronic_warfare_desc": "Each level of this extension raises the EW strength of [[Help:Engineering_and_electronics|ECMs and sensor suppressors]] by an additional {%BONUS100%}%.\n  ",
  "ext_tracking_disruptor_desc": "Each level of this extension reduces the CPU usage of ECMs by an additional {%BONUS100%}%.\n  ",
  "ext_sensor_linking_desc": "Each level of this extension enhances the target locking time modifier of [[Help:Engineering_and_electronics|sensor amplifiers and remote sensor amplifiers]] by an additional {%BONUS100%}%.\n  ",
  "ext_sensor_dampener_strength_desc": "Each level of this extension enhances the locking time modifier of sensor suppressors by an additional {%BONUS100%}%.\n  ",
  "ext_propulsion_disabling_ext": "Each level of this extension raises the efficiency of demobilizers by an additional {%BONUS100%}%.\n  ",
  "ext_long_range_targeting_desc": "Each level of this extension raises the [[Help:Robot_parameters|locking range]] of your robots' targeting computer by an additional {%BONUS100%}%.\n  ",
  "ext_remote_sensor_booster_desc": "Each level of this extension reduces the accumulator usage of remote sensor amplifiers by an additional {%BONUS100%}%.\n  ",
  "ext_ecm_strength_desc": "Each level of this extension further raises the EW strength of [[Help:Engineering_and_electronics|ECMs and sensor suppressors]] by an additional {%BONUS100%}%.\n  ",
  "ext_long_distance_electronic_warfare_desc": "Each level of this extension raises the [[Help:Combat_in_numbers|optimal range]] of [[Help:Engineering_and_electronics|electronic warfare]] modules by an additional {%BONUS100%}%.\n  ",
  "ext_targeting_speed_enhancer_desc": "Each level of this extension reduces the target locking time by an additional {%BONUS100%}%.\n  ",
  "ext_electronics_upgrades_desc": "Each level of this extension reduces the [[Help:Item_Information|CPU usage]] of [[Help:Engineering_and_electronics|electronic warfare]] modules by an additional {%BONUS100%}%.\n  ",
  "ext_projectile_turret_desc": "Each level of this extension raises the damage of light firearms by an additional {%BONUS100%}%.\n  ",
  "ext_railgun_desc": "Each level of this extension raises the damage of light magnetic weapons by an additional {%BONUS100%}%.\n  ",
  "ext_laser_desc": "Each level of this extension raises the damage of light [[Help:Weapons_and_ammo|lasers]] by an additional {%BONUS100%}%.\n  ",
  "ext_target_analysis_desc": "Each level of this extension raises the damage of all turrets and missiles by an additional {%BONUS100%}%.\n  ",
  "ext_accuracy_desc": "Each level of this extension reduces the [[Help:Combat_in_numbers|hit dispersion]] of all [[Help:Weapons_and_ammo|turrets]] by an additional {%BONUS100%}%.\n  ",
