  "tutorialchecklist_advanced_extensions_trigger01_title": "Open the Agent profile window\n  ",
  "tutorialchecklist_advanced_extensions_trigger02_title": "Select the “Extensions” tab on the Agent profile window\n  ",
  "tutorialchecklist_advanced_extensions_trigger03_title": "Upgrade an extension of your choice\n  ",
  "tutorialchecklist_advanced_sparks": "Sparks\n  ",
  "tutorialchecklist_advanced_sparks_trigger01_title": "Select the “Sparks” tab on the Agent profile window\n  ",
  "tutorialchecklist_advanced_sparks_trigger02_title": "Install a spark of your choice\n  ",
  "tutorialchecklist_advanced_repairshop": "Repair shop\n  ",
  "tutorialchecklist_advanced_repairshop_trigger01_title": "Open the Repair shop window\n  ",
  "tutorialchecklist_advanced_market": "Market\n  ",
  "tutorialchecklist_advanced_market_trigger01_title": "Open the Market window\n  ",
  "tutorialchecklist_advanced_market_trigger02_title": "Purchase a Sequer on the market\n  ",
  "tutorialchecklist_advanced_market_trigger03_title": "Right-click the Sequer in your private storage and select “Unpack”\n  ",
  "tutorialchecklist_advanced_market_trigger04_title": "Right-click the Sequer in your private storage and select “Activate”\n  ",
  "tutorialchecklist_advanced_assignments": "Assignments\n  ",
  "tutorialchecklist_advanced_assignments_trigger01_title": "Open the Assignments window\n  ",
  "tutorialchecklist_advanced_assignments_trigger02_title": "Click on the “Transport” box and request an assignment from it\n  ",
  "tutorialchecklist_advanced_assignments_trigger03_title": "Click Deploy to leave the terminal\n  ",
  "tutorialchecklist_advanced_assignments_trigger04_title": "Turn on the Assignments (terrain) window\n  ",
  "tutorialchecklist_advanced_assignments_trigger05_title": "Complete the “Transport training” assignment\n  ",
  "tutorialchecklist_advanced_assignments_trigger06_title": "Enter the Virtual Training Terminal\n  ",
  "tutorialchecklist_advanced_scanningmining": "Scanning & mining\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger01_title": "Right-click the Argano in your private storage and select “Activate”\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger02_title": "Click Deploy to leave the terminal\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger03_title": "Move close to the Terminal teleport, activate it, and select “Industrial area” as your destination\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger04_title": "Load “Directional geoscanner charge (Solibdit)” into your geoscanner module\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger05_title": "Click on your geoscanner module to activate it\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger06_title": "Find the Solibdit mineral field using your directional scanner\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger07_title": "Load “Tile-based geoscanner charge (Solibdit)” into your geoscanner module\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger08_title": "Click on your geoscanner module to activate it\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger09_title": "Select and lock a ground tile that contains Solibdit\n  ",
  "tutorialchecklist_advanced_scanningmining_trigger10_title": "Activate your miner module to mine some Solibdit\n  ",
