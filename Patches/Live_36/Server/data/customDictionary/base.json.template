  "def_missionitem_tm_ww_level02_exp3_01_t02": "Data console [Tornado I/1]\n  ",
  "missiontarget_activate_ww_level02_exp3_01_target03": "It seems that it's encrypted. Bring it to one of our stations to decode it.\n  ",
  "missiontarget_activate_ww_level02_exp3_01_target04": "The report is done, fetch it from our data center.\n  ",
